---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="container">
    <h1>Home by October</h1>
    <p>Accountability dashboard. Phase 1 deployed successfully.</p>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.5rem;
    color: #166534;
    margin-bottom: 1rem;
  }
  p {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #6b7280;
    font-size: 1.125rem;
  }
</style>
