---
interface Props {
  title?: string;
}

const { title = 'Home by October' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Home loan accountability dashboard" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">Home by October</a>
        <button id="logout-btn" class="logout-btn" type="button">Sign out</button>
      </div>
    </header>
    <main>
      <slot />
    </main>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    </script>
  </body>
</html>

<style>
  @import '../styles/global.css';

  header {
    background: white;
    border-bottom: 1px solid #e8e6df;
    padding: 0.75rem 1.5rem;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #166534;
    text-decoration: none;
  }

  .logout-btn {
    background: none;
    border: 1px solid #e8e6df;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: #6b7280;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transition: border-color 0.15s, color 0.15s;
  }

  .logout-btn:hover {
    border-color: #9ca3af;
    color: #374151;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
  }
</style>
