---
interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Home by October', activeNav = 'overview' } = Astro.props;

const navItems = [
  { id: 'overview', label: 'Overview', href: '/' },
  { id: 'spending', label: 'Spending', href: '/spending' },
  { id: 'timeline', label: 'Timeline', href: '/timeline' },
  { id: 'broker', label: 'Broker Ready', href: '/broker' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Home loan accountability dashboard" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">Home by October</a>
        <nav class="desktop-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', { active: activeNav === item.id }]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <button id="logout-btn" class="logout-btn" type="button">Sign out</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <nav class="mobile-nav">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['mobile-nav-link', { active: activeNav === item.id }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    </script>
  </body>
</html>

<style>
  @import '../styles/global.css';

  html, body {
    margin: 0;
    padding: 0;
  }

  header {
    background: white;
    border-bottom: 1px solid #e8e6df;
    padding: 0 1.5rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .logo {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #166534;
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: #374151;
    background: #f3f4f6;
  }

  .nav-link.active {
    color: #166534;
    background: #f0fdf4;
  }

  .logout-btn {
    background: none;
    border: 1px solid #e8e6df;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    color: #6b7280;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .logout-btn:hover {
    border-color: #9ca3af;
    color: #374151;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
    padding-bottom: 5rem;
  }

  .mobile-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-top: 1px solid #e8e6df;
    z-index: 50;
  }

  .mobile-nav-link {
    flex: 1;
    text-align: center;
    padding: 0.75rem 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .mobile-nav-link.active {
    color: #166534;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: flex;
    }

    main {
      padding-bottom: 6rem;
    }
  }
</style>
